DATABASE_URL="postgresql://postgres:password@localhost:5432/betting_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-use-256-bit-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
NODE_ENV="development"
PORT=3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Public URLs — used to build SSLCommerz success/fail/cancel/IPN callback URLs
# and the redirect target after a deposit resolves. Must be reachable from
# the internet in production (SSLCommerz's servers call API_PUBLIC_URL directly).
API_PUBLIC_URL="http://localhost:3000/api/v1"
FRONTEND_URL="http://localhost:3001"

# SSLCommerz (https://developer.sslcommerz.com) — powers bKash, Nagad, Rocket,
# Upay, mCash, Tap, cards, and net banking through a single gateway.
# Get sandbox credentials at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
# "true" switches from sandbox.sslcommerz.com to securepay.sslcommerz.com —
# only do this with real, approved merchant credentials.
SSLCOMMERZ_LIVE="false"
