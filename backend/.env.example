DATABASE_URL="postgresql://postgres:password@localhost:5432/betting_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-use-256-bit-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
NODE_ENV="development"
PORT=3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Public URLs — used to build SSLCommerz success/fail/cancel/IPN callback URLs
# and the redirect target after a deposit resolves. Must be reachable from
# the internet in production (SSLCommerz's servers call API_PUBLIC_URL directly).
API_PUBLIC_URL="http://localhost:3000/api/v1"
FRONTEND_URL="http://localhost:3001"

# SSLCommerz (https://developer.sslcommerz.com) — powers bKash, Nagad, Rocket,
# Upay, mCash, Tap, cards, and net banking through a single gateway.
# Get sandbox credentials at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
# "true" switches from sandbox.sslcommerz.com to securepay.sslcommerz.com —
# only do this with real, approved merchant credentials.
SSLCOMMERZ_LIVE="false"

# ─── Self-hosted BD Payment Gateway ────────────────────────────────────────
# The bKash/Nagad/Rocket/Upay gateway in the paymentgw repo. Customers Send
# Money to your own numbers and the gateway verifies it from the forwarded SMS.
# Create a merchant in the gateway's admin dashboard to get these; the API
# secret and webhook secret are shown exactly once, at creation.
#   Webhook URL to register there:
#     <API_PUBLIC_URL>/payment/deposit/bdgateway/webhook
BD_GATEWAY_URL="https://your-gateway.netlify.app"
BD_GATEWAY_API_KEY="pk_..."
BD_GATEWAY_API_SECRET="sk_..."
# Verifies the X-Gateway-Signature HMAC on inbound webhooks. Without it every
# webhook is rejected.
BD_GATEWAY_WEBHOOK_SECRET="whsec_..."
BD_GATEWAY_TIMEOUT_MS=10000

# ─── Netlify / serverless ──────────────────────────────────────────────────
# Browser origin allowed to call this API. Comma-separate for several; "*"
# allows any (fine here — auth is Bearer-token, not cookie based).
ALLOWED_ORIGIN="http://localhost:3001"
# Shared secret for POST /api/v1/internal/cron/* — the Netlify Scheduled
# Function that replaces the in-process @Cron jobs authenticates with it.
#   openssl rand -hex 32
CRON_SECRET=""
# Set to "true" to skip the in-process @Cron jobs (Netlify sets NETLIFY=true
# automatically, so you rarely need this by hand).
DISABLE_IN_PROCESS_CRON="false"

