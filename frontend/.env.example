# Base URL of the NestJS backend, including the /api/v1 global prefix.
#
# Local development:
#   # This value is for local development only. Production Netlify builds use the
# backend URL from frontend/netlify.toml unless a different remote URL is set.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
#
# Production Netlify builds use a same-origin /api/v1 proxy defined in
# frontend/netlify.toml. This variable is only used for local development.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
