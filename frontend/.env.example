# Base URL of the NestJS backend, including the /api/v1 global prefix.
#
# Local development:
#   NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
#
# Netlify: point this at the backend site (the one whose base directory is
# `backend`), not at this site. NEXT_PUBLIC_* values are inlined at build time,
# so changing it in the Netlify UI requires a redeploy of this site to take
# effect.
#   NEXT_PUBLIC_API_URL="https://your-backend-site.netlify.app/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
